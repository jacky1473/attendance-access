[Unit]
Description=easyWDMS Web GUI Attendance Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/attendance-access
ExecStart=/usr/bin/python3 /opt/attendance-access/app.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
